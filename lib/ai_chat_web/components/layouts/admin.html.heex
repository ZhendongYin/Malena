<div class="h-screen bg-base-100 flex">
  <!-- Sidebar -->
  <.admin_sidebar current_page={@current_page} user={@current_user} />

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col">
    <!-- Top Navigation Bar -->
    <.admin_nav current_page={@current_page} user={@current_user} />

    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto lg:ml-64">
      <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <div class="px-4 py-6 sm:px-0">
          {@inner_content}
        </div>
      </div>
    </main>
  </div>

  <!-- Flash Messages -->
  <.flash_group flash={@flash} />
</div>
