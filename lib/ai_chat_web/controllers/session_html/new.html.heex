<div class="min-h-screen flex items-center justify-center bg-base-100 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-base-content">
        Sign in to AI Chat
      </h2>
      <p class="mt-2 text-center text-sm text-base-content/70">
        Or
        <.link
          href={~p"/register"}
          class="font-medium text-primary hover:text-primary/80"
        >
          create a new account
        </.link>
      </p>
    </div>
    
    <.form for={%{}} as={:session} action={~p"/login"} method="post" class="mt-8 space-y-6">
      <div class="card bg-base-200 shadow-xl">
        <div class="card-body space-y-4">
          <div class="form-control">
            <label for="session_email" class="label">
              <span class="label-text text-base-content">Email address</span>
            </label>
            <input
              id="session_email"
              name="session[email]"
              type="email"
              autocomplete="email"
              required
              class="input input-bordered w-full bg-base-100 text-base-content placeholder-base-content/50"
              placeholder="Email address"
            />
          </div>
          
          <div class="form-control">
            <label for="session_password" class="label">
              <span class="label-text text-base-content">Password</span>
            </label>
            <input
              id="session_password"
              name="session[password]"
              type="password"
              autocomplete="current-password"
              required
              class="input input-bordered w-full bg-base-100 text-base-content placeholder-base-content/50"
              placeholder="Password"
            />
          </div>

          <div class="form-control mt-6">
            <button
              type="submit"
              class="btn btn-primary w-full"
            >
              Sign in
            </button>
          </div>
        </div>
      </div>
    </.form>

    <div class="mt-6">
      <div class="relative">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-base-300" />
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-2 bg-base-100 text-base-content/70">Test Accounts</span>
        </div>
      </div>
      
      <div class="mt-4 text-sm text-base-content/80">
        <p class="font-medium">Available test accounts:</p>
        <ul class="mt-2 space-y-1">
          <li>• <strong>Super Admin:</strong> admin@aichat.com / password123</li>
          <li>• <strong>HR Manager:</strong> hr.manager@aichat.com / password123</li>
          <li>• <strong>HR Employee:</strong> hr.employee@aichat.com / password123</li>
          <li>• <strong>IT Manager:</strong> it.manager@aichat.com / password123</li>
        </ul>
      </div>
    </div>
  </div>
</div>
