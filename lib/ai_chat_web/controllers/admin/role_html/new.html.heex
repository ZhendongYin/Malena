<div class="max-w-2xl mx-auto">
  <div class="mb-6 flex justify-end">
    <.link
      href={~p"/admin/roles"}
      class="btn btn-sm btn-outline border-base-content"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Roles
    </.link>
  </div>

  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <h2 class="card-title">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Create New Role
      </h2>

      <.form 
        for={@changeset} 
        action={~p"/admin/roles"} 
        method="post"
        class="space-y-4"
        autocomplete="off"
      >
        <div class="form-control">
          <label class="label">
            <span class="label-text">Name <span class="text-error">*</span></span>
          </label>
          <input
            id="role_name"
            name="role[name]"
            type="text"
            value={@changeset.data.name || ""}
            required
            autocomplete="off"
            class="input input-bordered w-full"
            placeholder="Enter role name"
          />
          <p :if={@changeset.errors[:name]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:name], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Description</span>
          </label>
          <textarea
            id="role_description"
            name="role[description]"
            class="textarea textarea-bordered w-full"
            placeholder="Enter role description"
            rows="3"
          ><%= @changeset.data.description || "" %></textarea>
          <p :if={@changeset.errors[:description]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:description], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Permissions <span class="text-error">*</span></span>
          </label>
          <div class="grid grid-cols-2 gap-2 p-4 border border-base-300 rounded-lg">
            <label class="label cursor-pointer">
              <span class="label-text">Access Chat</span>
              <input
                type="checkbox"
                name="role[permissions][access_chat]"
                value="true"
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">Manage Users</span>
              <input
                type="checkbox"
                name="role[permissions][manage_users]"
                value="true"
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">Manage Departments</span>
              <input
                type="checkbox"
                name="role[permissions][manage_departments]"
                value="true"
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">Manage Roles</span>
              <input
                type="checkbox"
                name="role[permissions][manage_roles]"
                value="true"
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">Manage Prompts</span>
              <input
                type="checkbox"
                name="role[permissions][manage_prompts]"
                value="true"
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">Manage Knowledge Bases</span>
              <input
                type="checkbox"
                name="role[permissions][manage_knowledge_bases]"
                value="true"
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">Manage AI APIs</span>
              <input
                type="checkbox"
                name="role[permissions][manage_ai_apis]"
                value="true"
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">View Analytics</span>
              <input
                type="checkbox"
                name="role[permissions][view_analytics]"
                value="true"
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">API Access</span>
              <input
                type="checkbox"
                name="role[permissions][api_access]"
                value="true"
                class="checkbox checkbox-primary"
              />
            </label>
          </div>
          <p :if={@changeset.errors[:permissions]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:permissions], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">Active</span>
            <input
              type="hidden"
              name="role[is_active]"
              value="false"
            />
            <input
              id="role_is_active"
              name="role[is_active]"
              type="checkbox"
              value="true"
              checked={@changeset.data.is_active}
              class="toggle toggle-primary"
            />
          </label>
          <p :if={@changeset.errors[:is_active]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:is_active], 0) %>
          </p>
        </div>

        <div class="card-actions justify-end">
          <.link 
            href={~p"/admin/roles"} 
            class="btn btn-sm btn-outline border-base-content"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            Cancel
          </.link>
          <button type="submit" class="btn btn-sm btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Create Role
          </button>
        </div>
      </.form>
    </div>
  </div>
</div>
