<div class="max-w-2xl mx-auto">
  <div class="mb-6 flex justify-end">
    <.link
      href={~p"/admin/roles"}
      class="btn btn-sm btn-outline border-base-content"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Roles
    </.link>
  </div>

  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <h2 class="card-title">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
        Edit Role
      </h2>

      <.form 
        for={@changeset} 
        action={~p"/admin/roles/#{@role.id}"} 
        method="put"
        class="space-y-4"
        autocomplete="off"
        data-has-users={@has_users}
        data-has-prompts={@has_prompts}
        data-has-knowledge-bases={@has_knowledge_bases}
        id="role-form"
      >
        <div class="form-control">
          <label class="label">
            <span class="label-text">Name <span class="text-error">*</span></span>
          </label>
          <input
            id="role_name"
            name="role[name]"
            type="text"
            value={@role.name}
            required
            autocomplete="off"
            class="input input-bordered w-full"
            placeholder="Enter role name"
          />
          <p :if={@changeset.errors[:name]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:name], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Description</span>
          </label>
          <textarea
            id="role_description"
            name="role[description]"
            class="textarea textarea-bordered w-full"
            placeholder="Enter role description"
            rows="3"
          ><%= @role.description || "" %></textarea>
          <p :if={@changeset.errors[:description]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:description], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Permissions <span class="text-error">*</span></span>
          </label>
          <div class="grid grid-cols-2 gap-2 p-4 border border-base-300 rounded-lg">
            <label class="label cursor-pointer">
              <span class="label-text">Access Chat</span>
              <input
                type="checkbox"
                name="role[permissions][access_chat]"
                value="true"
                checked={get_in(@role.permissions, ["access_chat"]) == true}
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">Manage Users</span>
              <input
                type="checkbox"
                name="role[permissions][manage_users]"
                value="true"
                checked={get_in(@role.permissions, ["manage_users"]) == true}
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">Manage Departments</span>
              <input
                type="checkbox"
                name="role[permissions][manage_departments]"
                value="true"
                checked={get_in(@role.permissions, ["manage_departments"]) == true}
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">Manage Roles</span>
              <input
                type="checkbox"
                name="role[permissions][manage_roles]"
                value="true"
                checked={get_in(@role.permissions, ["manage_roles"]) == true}
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">Manage Prompts</span>
              <input
                type="checkbox"
                name="role[permissions][manage_prompts]"
                value="true"
                checked={get_in(@role.permissions, ["manage_prompts"]) == true}
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">Manage Knowledge Bases</span>
              <input
                type="checkbox"
                name="role[permissions][manage_knowledge_bases]"
                value="true"
                checked={get_in(@role.permissions, ["manage_knowledge_bases"]) == true}
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">Manage AI APIs</span>
              <input
                type="checkbox"
                name="role[permissions][manage_ai_apis]"
                value="true"
                checked={get_in(@role.permissions, ["manage_ai_apis"]) == true}
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">View Analytics</span>
              <input
                type="checkbox"
                name="role[permissions][view_analytics]"
                value="true"
                checked={get_in(@role.permissions, ["view_analytics"]) == true}
                class="checkbox checkbox-primary"
              />
            </label>
            <label class="label cursor-pointer">
              <span class="label-text">API Access</span>
              <input
                type="checkbox"
                name="role[permissions][api_access]"
                value="true"
                checked={get_in(@role.permissions, ["api_access"]) == true}
                class="checkbox checkbox-primary"
              />
            </label>
          </div>
          <p :if={@changeset.errors[:permissions]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:permissions], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">Active</span>
            <input
              type="hidden"
              name="role[is_active]"
              value="false"
            />
            <input
              id="role_is_active"
              name="role[is_active]"
              type="checkbox"
              value="true"
              checked={@role.is_active}
              class="toggle toggle-primary"
            />
          </label>
          <p :if={@changeset.errors[:is_active]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:is_active], 0) %>
          </p>
        </div>

        <div class="card-actions justify-end">
          <.link 
            href={~p"/admin/roles"} 
            class="btn btn-sm btn-outline border-base-content"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            Cancel
          </.link>
          <button type="submit" class="btn btn-sm btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Update Role
          </button>
        </div>
      </.form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('role-form');
  const activeCheckbox = document.getElementById('role_is_active');
  
  if (form && activeCheckbox) {
    form.addEventListener('submit', function(e) {
      // 检查是否试图将active设置为false
      if (!activeCheckbox.checked) {
        const hasUsers = form.dataset.hasUsers === 'true';
        const hasPrompts = form.dataset.hasPrompts === 'true';
        const hasKnowledgeBases = form.dataset.hasKnowledgeBases === 'true';
        
        if (hasUsers || hasPrompts || hasKnowledgeBases) {
          e.preventDefault();
          
          let message = 'Cannot deactivate this role because it is associated with: ';
          const associations = [];
          
          if (hasUsers) associations.push('Users');
          if (hasPrompts) associations.push('Prompts');
          if (hasKnowledgeBases) associations.push('Knowledge Bases');
          
          message += associations.join(', ');
          
          alert(message);
          return false;
        }
      }
    });
  }
});
</script>
