<div class="max-w-2xl mx-auto">
  <div class="mb-6 flex justify-end">
    <.link
      href={~p"/admin/users"}
      class="btn btn-sm btn-outline border-base-content"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Users
    </.link>
  </div>

  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <h2 class="card-title">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Create New User
      </h2>

      <.form 
        for={@changeset} 
        action={~p"/admin/users"} 
        method="post"
        class="space-y-4"
        autocomplete="off"
      >
        <div class="form-control">
          <label class="label">
            <span class="label-text">Name <span class="text-error">*</span></span>
          </label>
          <input
            id="user_name"
            name="user[name]"
            type="text"
            value={@changeset.data.name || ""}
            required
            autocomplete="off"
            class="input input-bordered w-full"
            placeholder="Enter user name"
          />
          <p :if={@changeset.errors[:name]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:name], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Email <span class="text-error">*</span></span>
          </label>
          <input
            id="user_email"
            name="user[email]"
            type="email"
            value={@changeset.data.email || ""}
            required
            autocomplete="off"
            class="input input-bordered w-full"
            placeholder="Enter email address"
          />
          <p :if={@changeset.errors[:email]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:email], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Password <span class="text-error">*</span></span>
          </label>
          <input
            id="user_password"
            name="user[password]"
            type="password"
            value={@changeset.data.password || ""}
            required
            autocomplete="new-password"
            class="input input-bordered w-full"
            placeholder="Enter password"
          />
          <p :if={@changeset.errors[:password]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:password], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Department <span class="text-error">*</span></span>
          </label>
          <select
            id="user_department_id"
            name="user[department_id]"
            class="select select-bordered w-full"
            required
          >
            <option value="">Select Department</option>
            <option :for={dept <- @departments} value={dept.id} selected={dept.id == @changeset.data.department_id}>
              <%= dept.name %>
            </option>
          </select>
          <p :if={@changeset.errors[:department_id]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:department_id], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Role <span class="text-error">*</span></span>
          </label>
          <select
            id="user_role_id"
            name="user[role_id]"
            class="select select-bordered w-full"
            required
          >
            <option value="">Select Role</option>
            <option :for={role <- @roles} value={role.id} selected={role.id == @changeset.data.role_id}>
              <%= role.name %>
            </option>
          </select>
          <p :if={@changeset.errors[:role_id]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:role_id], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">Active</span>
            <input
              type="hidden"
              name="user[is_active]"
              value="false"
            />
            <input
              id="user_is_active"
              name="user[is_active]"
              type="checkbox"
              value="true"
              checked={@changeset.data.is_active}
              class="toggle toggle-primary"
            />
          </label>
          <p :if={@changeset.errors[:is_active]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:is_active], 0) %>
          </p>
        </div>

        <div class="card-actions justify-end">
          <.link 
            href={~p"/admin/users"} 
            class="btn btn-sm btn-outline border-base-content"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            Cancel
          </.link>
          <button type="submit" class="btn btn-sm btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Create User
          </button>
        </div>
      </.form>
    </div>
  </div>
</div>