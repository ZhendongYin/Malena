<div class="max-w-2xl mx-auto">
  <div class="mb-6 flex justify-end">
    <.link
      href={~p"/admin/ai-apis"}
      class="btn btn-sm btn-outline border-base-content"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to AI APIs
    </.link>
  </div>

  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <h2 class="card-title">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
        Edit AI API
      </h2>

      <.form 
        for={@changeset} 
        action={~p"/admin/ai-apis/#{@ai_api.id}"} 
        method="put"
        class="space-y-4"
        autocomplete="off"
      >
        <div class="form-control">
          <label class="label">
            <span class="label-text">Name <span class="text-error">*</span></span>
          </label>
          <input
            id="ai_api_name"
            name="ai_api[name]"
            type="text"
            value={@ai_api.name}
            required
            autocomplete="off"
            class="input input-bordered w-full"
            placeholder="Enter AI API name"
          />
          <p :if={@changeset.errors[:name]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:name], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Provider <span class="text-error">*</span></span>
          </label>
          <select
            id="ai_api_provider"
            name="ai_api[provider]"
            class="select select-bordered w-full"
            required
          >
            <option value="">Select Provider</option>
            <option value="openai" selected={@ai_api.provider == "openai"}>OpenAI</option>
            <option value="claude" selected={@ai_api.provider == "claude"}>Anthropic Claude</option>
            <option value="gemini" selected={@ai_api.provider == "gemini"}>Google Gemini</option>
            <option value="ollama" selected={@ai_api.provider == "ollama"}>Ollama</option>
          </select>
          <p :if={@changeset.errors[:provider]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:provider], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">API Key</span>
          </label>
          <input
            id="ai_api_api_key"
            name="ai_api[api_key]"
            type="password"
            value=""
            autocomplete="new-password"
            class="input input-bordered w-full"
            placeholder="Enter new API key (leave blank to keep current)"
          />
          <p class="text-sm text-base-content/70">Leave empty to keep current API key or for Ollama</p>
          <p :if={@changeset.errors[:api_key]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:api_key], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Base URL</span>
          </label>
          <input
            id="ai_api_base_url"
            name="ai_api[base_url]"
            type="url"
            value={@ai_api.base_url || ""}
            autocomplete="off"
            class="input input-bordered w-full"
            placeholder="Enter base URL (optional)"
          />
          <p :if={@changeset.errors[:base_url]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:base_url], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Model Name <span class="text-error">*</span></span>
          </label>
          <input
            id="ai_api_model_name"
            name="ai_api[model_name]"
            type="text"
            value={@ai_api.model_name}
            required
            autocomplete="off"
            class="input input-bordered w-full"
            placeholder="Enter model name (e.g., gpt-4, claude-3-sonnet)"
          />
          <p :if={@changeset.errors[:model_name]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:model_name], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Department</span>
          </label>
          <select
            id="ai_api_department_id"
            name="ai_api[department_id]"
            class="select select-bordered w-full"
          >
            <option value="">Select Department (Optional)</option>
            <option :for={dept <- @departments} value={dept.id} selected={dept.id == @ai_api.department_id}>
              <%= dept.name %>
            </option>
          </select>
          <p :if={@changeset.errors[:department_id]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:department_id], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Role</span>
          </label>
          <select
            id="ai_api_role_id"
            name="ai_api[role_id]"
            class="select select-bordered w-full"
          >
            <option value="">Select Role (Optional)</option>
            <option :for={role <- @roles} value={role.id} selected={role.id == @ai_api.role_id}>
              <%= role.name %>
            </option>
          </select>
          <p :if={@changeset.errors[:role_id]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:role_id], 0) %>
          </p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="form-control">
            <label class="label">
              <span class="label-text">Rate Limit</span>
            </label>
            <input
              id="ai_api_rate_limit"
              name="ai_api[rate_limit]"
              type="number"
              value={@ai_api.rate_limit}
              min="1"
              class="input input-bordered w-full"
              placeholder="100"
            />
            <p :if={@changeset.errors[:rate_limit]} class="text-error text-sm mt-1">
              <%= elem(@changeset.errors[:rate_limit], 0) %>
            </p>
          </div>

          <div class="form-control">
            <label class="label">
              <span class="label-text">Max Tokens</span>
            </label>
            <input
              id="ai_api_max_tokens"
              name="ai_api[max_tokens]"
              type="number"
              value={@ai_api.max_tokens}
              min="1"
              class="input input-bordered w-full"
              placeholder="4000"
            />
            <p :if={@changeset.errors[:max_tokens]} class="text-error text-sm mt-1">
              <%= elem(@changeset.errors[:max_tokens], 0) %>
            </p>
          </div>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Temperature</span>
          </label>
          <input
            id="ai_api_temperature"
            name="ai_api[temperature]"
            type="number"
            step="0.1"
            min="0.0"
            max="2.0"
            value={@ai_api.temperature}
            class="input input-bordered w-full"
            placeholder="0.7"
          />
          <p :if={@changeset.errors[:temperature]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:temperature], 0) %>
          </p>
        </div>


        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">Default API</span>
            <input
              id="ai_api_is_default"
              name="ai_api[is_default]"
              type="checkbox"
              value="true"
              checked={@ai_api.is_default}
              class="toggle toggle-primary"
            />
          </label>
          <p :if={@changeset.errors[:is_default]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:is_default], 0) %>
          </p>
        </div>

        <div class="card-actions justify-end">
          <.link 
            href={~p"/admin/ai-apis"} 
            class="btn btn-sm btn-outline border-base-content"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            Cancel
          </.link>
          <button type="submit" class="btn btn-sm btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Update AI API
          </button>
        </div>
      </.form>
    </div>
  </div>
</div>
