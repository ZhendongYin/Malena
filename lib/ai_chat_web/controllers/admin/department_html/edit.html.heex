<div class="max-w-2xl mx-auto">
  <div class="mb-6 flex justify-end">
    <.link
      href={~p"/admin/departments"}
      class="btn btn-sm btn-outline border-base-content"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Departments
    </.link>
  </div>

  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <h2 class="card-title">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
        Edit Department
      </h2>

      <.form 
        for={@changeset} 
        action={~p"/admin/departments/#{@department.id}"} 
        method="put"
        class="space-y-4"
        autocomplete="off"
        data-has-users={@has_users}
        data-has-prompts={@has_prompts}
        data-has-knowledge-bases={@has_knowledge_bases}
        data-has-child-departments={@has_child_departments}
        id="department-form"
      >
        <div class="form-control">
          <label class="label">
            <span class="label-text">Name <span class="text-error">*</span></span>
          </label>
          <input
            id="department_name"
            name="department[name]"
            type="text"
            value={@department.name}
            required
            autocomplete="off"
            class="input input-bordered w-full"
            placeholder="Enter department name"
          />
          <p :if={@changeset.errors[:name]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:name], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Description</span>
          </label>
          <textarea
            id="department_description"
            name="department[description]"
            class="textarea textarea-bordered w-full"
            placeholder="Enter department description"
            rows="3"
          ><%= @department.description || "" %></textarea>
          <p :if={@changeset.errors[:description]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:description], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Parent Department</span>
          </label>
          <select
            id="department_parent_id"
            name="department[parent_id]"
            class="select select-bordered w-full"
          >
            <option value="">No Parent Department</option>
            <option :for={dept <- @departments} value={dept.id} selected={dept.id == @department.parent_id}>
              <%= dept.name %>
            </option>
          </select>
          <p :if={@changeset.errors[:parent_id]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:parent_id], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">API Access Enabled</span>
            <input
              id="department_api_access_enabled"
              name="department[api_access_enabled]"
              type="checkbox"
              value="true"
              checked={@department.api_access_enabled}
              class="toggle toggle-primary"
            />
          </label>
          <p :if={@changeset.errors[:api_access_enabled]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:api_access_enabled], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">Active</span>
            <input
              type="hidden"
              name="department[is_active]"
              value="false"
            />
            <input
              id="department_is_active"
              name="department[is_active]"
              type="checkbox"
              value="true"
              checked={@department.is_active}
              class="toggle toggle-primary"
            />
          </label>
          <p :if={@changeset.errors[:is_active]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:is_active], 0) %>
          </p>
        </div>

        <div class="card-actions justify-end">
          <.link 
            href={~p"/admin/departments"} 
            class="btn btn-sm btn-outline border-base-content"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            Cancel
          </.link>
          <button type="submit" class="btn btn-sm btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Update Department
          </button>
        </div>
      </.form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('department-form');
  const activeCheckbox = document.getElementById('department_is_active');
  
  if (form && activeCheckbox) {
    form.addEventListener('submit', function(e) {
      // 检查是否试图将active设置为false
      if (!activeCheckbox.checked) {
        const hasUsers = form.dataset.hasUsers === 'true';
        const hasPrompts = form.dataset.hasPrompts === 'true';
        const hasKnowledgeBases = form.dataset.hasKnowledgeBases === 'true';
        const hasChildDepartments = form.dataset.hasChildDepartments === 'true';
        
        if (hasUsers || hasPrompts || hasKnowledgeBases || hasChildDepartments) {
          e.preventDefault();
          
          let message = 'Cannot deactivate this department because it is associated with: ';
          const associations = [];
          
          if (hasUsers) associations.push('Users');
          if (hasPrompts) associations.push('Prompts');
          if (hasKnowledgeBases) associations.push('Knowledge Bases');
          if (hasChildDepartments) associations.push('Child Departments');
          
          message += associations.join(', ');
          
          alert(message);
          return false;
        }
      }
    });
  }
});
</script>
