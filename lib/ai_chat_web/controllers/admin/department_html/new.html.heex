<div class="max-w-2xl mx-auto">
  <div class="mb-6 flex justify-end">
    <.link
      href={~p"/admin/departments"}
      class="btn btn-sm btn-outline border-base-content"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Departments
    </.link>
  </div>

  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <h2 class="card-title">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Create New Department
      </h2>

      <.form 
        for={@changeset} 
        action={~p"/admin/departments"} 
        method="post"
        class="space-y-4"
        autocomplete="off"
      >
        <div class="form-control">
          <label class="label">
            <span class="label-text">Name <span class="text-error">*</span></span>
          </label>
          <input
            id="department_name"
            name="department[name]"
            type="text"
            value={@changeset.data.name || ""}
            required
            autocomplete="off"
            class="input input-bordered w-full"
            placeholder="Enter department name"
          />
          <p :if={@changeset.errors[:name]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:name], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Description</span>
          </label>
          <textarea
            id="department_description"
            name="department[description]"
            class="textarea textarea-bordered w-full"
            placeholder="Enter department description"
            rows="3"
          ><%= @changeset.data.description || "" %></textarea>
          <p :if={@changeset.errors[:description]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:description], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Parent Department</span>
          </label>
          <select
            id="department_parent_id"
            name="department[parent_id]"
            class="select select-bordered w-full"
          >
            <option value="">No Parent Department</option>
            <option :for={dept <- @departments} value={dept.id} selected={dept.id == @changeset.data.parent_id}>
              <%= dept.name %>
            </option>
          </select>
          <p :if={@changeset.errors[:parent_id]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:parent_id], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">API Access Enabled</span>
            <input
              id="department_api_access_enabled"
              name="department[api_access_enabled]"
              type="checkbox"
              value="true"
              checked={@changeset.data.api_access_enabled}
              class="toggle toggle-primary"
            />
          </label>
          <p :if={@changeset.errors[:api_access_enabled]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:api_access_enabled], 0) %>
          </p>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">Active</span>
            <input
              type="hidden"
              name="department[is_active]"
              value="false"
            />
            <input
              id="department_is_active"
              name="department[is_active]"
              type="checkbox"
              value="true"
              checked={@changeset.data.is_active}
              class="toggle toggle-primary"
            />
          </label>
          <p :if={@changeset.errors[:is_active]} class="text-error text-sm mt-1">
            <%= elem(@changeset.errors[:is_active], 0) %>
          </p>
        </div>

        <div class="card-actions justify-end">
          <.link 
            href={~p"/admin/departments"} 
            class="btn btn-sm btn-outline border-base-content"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            Cancel
          </.link>
          <button type="submit" class="btn btn-sm btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Create Department
          </button>
        </div>
      </.form>
    </div>
  </div>
</div>
