<div class="min-h-screen bg-base-100">
  <!-- Navigation -->
  <nav class="bg-base-200 border-b border-base-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <h1 class="text-xl font-bold text-base-content">AI Chat</h1>
          </div>
          <div class="ml-10 flex items-baseline space-x-4">
            <.link
              href={~p"/chat"}
              class="btn btn-primary btn-sm"
            >
              Chat
            </.link>
          </div>
        </div>
        
        <div class="flex items-center space-x-4">
          <!-- Theme Toggle -->
          <.theme_toggle />
          
          <div class="text-sm text-base-content">
            Welcome, <span class="font-medium"><%= @current_user.name %></span>
          </div>
          <.link
            href={~p"/logout"}
            method="delete"
            class="btn btn-error btn-sm"
          >
            Sign Out
          </.link>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="max-w-4xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <!-- Chat Header -->
      <div class="card bg-base-200 shadow-xl mb-6">
        <div class="px-6 py-4">
          <div class="flex items-center justify-between">
            <div>
              <h1 class="text-lg font-medium text-base-content">
                <%= @conversation.title || "Untitled Conversation" %>
              </h1>
              <p class="text-sm text-base-content/70">
                Started <%= Calendar.strftime(@conversation.inserted_at, "%B %d, %Y at %I:%M %p") %>
              </p>
            </div>
            <.link
              href={~p"/chat"}
              class="btn btn-outline btn-sm"
            >
              Back to Conversations
            </.link>
          </div>
        </div>
      </div>

      <!-- Chat Messages -->
      <div class="card bg-base-200 shadow-xl mb-6">
        <div class="px-6 py-4">
          <div class="space-y-4 min-h-96 max-h-96 overflow-y-auto" id="chat-messages">
            <div :for={message <- @messages} class={"flex #{if message.role == "user", do: "justify-end", else: "justify-start"}"}>
              <div class={"max-w-xs lg:max-w-md px-4 py-2 rounded-lg #{if message.role == "user", do: "bg-primary text-primary-content", else: "bg-base-300 text-base-content"}"}>
                <p class="text-sm"><%= message.content %></p>
                <p class={"text-xs mt-1 #{if message.role == "user", do: "text-primary-content/70", else: "text-base-content/70"}"}>
                  <%= Calendar.strftime(message.inserted_at, "%I:%M %p") %>
                </p>
              </div>
            </div>
            
            <div :if={Enum.empty?(@messages)} class="text-center text-base-content/70 py-8">
              <svg class="mx-auto h-12 w-12 text-base-content/50 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              <p>No messages yet. Start the conversation!</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Message Input -->
      <div class="card bg-base-200 shadow-xl">
        <div class="card-body">
          <.form for={%{}} action={~p"/chat/#{@conversation.id}/messages"} method="post" class="flex space-x-4">
            <div class="flex-1">
              <label for="message_content" class="sr-only">Message</label>
              <textarea
                name="message[content]"
                id="message_content"
                rows="3"
                class="textarea textarea-bordered w-full bg-base-100 text-base-content placeholder-base-content/50"
                placeholder="Type your message here..."
                required
              ></textarea>
            </div>
            <div class="flex-shrink-0">
              <button
                type="submit"
                class="btn btn-primary"
              >
                Send
              </button>
            </div>
          </.form>
        </div>
      </div>
    </div>
  </div>
</div>
