<!-- Page Header with Refresh Button -->
<div class="sm:flex sm:items-center">
  <div class="sm:flex-auto">
    <h1 class="text-2xl font-semibold text-base-content">
      <%= String.capitalize(@current_page) %>
    </h1>
    <p class="mt-2 text-sm text-base-content/80">
      <%= if @current_page == "users" do %>
        A list of all users in your account including their name, email, department, and role.
      <% else %>
        <%= if @current_page == "departments" do %>
          Manage organizational departments and their settings.
        <% else %>
          <%= if @current_page == "roles" do %>
            Define roles and permissions for different user types.
          <% else %>
            <%= if @current_page == "prompts" do %>
              Create and manage AI prompts for different departments and roles.
            <% else %>
              <%= if @current_page == "knowledge-bases" do %>
                Upload and manage knowledge base documents.
              <% else %>
                <%= if @current_page == "ai-apis" do %>
                  Configure AI API endpoints and models.
                <% else %>
                  Manage your account settings and data.
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </p>
  </div>
  <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none flex space-x-3">
    <button 
      phx-click="refresh" 
      class="btn btn-outline btn-sm"
      title="Refresh data"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
      </svg>
      Refresh
    </button>
    <.link
      href={if @current_page == "users", do: ~p"/admin/users/new", else: (if @current_page == "departments", do: ~p"/admin/departments/new", else: (if @current_page == "roles", do: ~p"/admin/roles/new", else: (if @current_page == "prompts", do: ~p"/admin/prompts/new", else: (if @current_page == "knowledge-bases", do: ~p"/admin/knowledge-bases/new", else: (if @current_page == "ai-apis", do: ~p"/admin/ai-apis/new", else: "#")))))}
      class="btn btn-primary"
    >
      Add <%= String.capitalize(String.replace(@current_page, "_", " ")) %>
    </.link>
  </div>
</div>

<!-- Real-time Status Indicator -->
<div class="mt-4">
  <div class="flex items-center text-sm text-base-content/70">
    <div class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></div>
    Live updates enabled
  </div>
</div>

<!-- Table Content -->
<div class="mt-8 flex flex-col">
  <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
      <div class="card bg-base-200 shadow-xl">
        <div class="card-body p-0">
              <%= if @current_page == "users" do %>
                <table class="min-w-full divide-y divide-base-300">
                  <thead class="bg-base-300">
                    <tr>
                      <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Name</th>
                      <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Email</th>
                      <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Department</th>
                      <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Role</th>
                      <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">AI API</th>
                      <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Status</th>
                      <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
                    </tr>
                  </thead>
                  <tbody class="bg-base-100 divide-y divide-base-300">
                    <tr :for={user <- @users} id={"user-#{user.id}"}>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                          <div class="flex-shrink-0 h-10 w-10">
                            <div class="h-10 w-10 rounded-full bg-base-300 flex items-center justify-center">
                              <span class="text-sm font-medium text-base-content">
                                <%= String.first(user.name) %>
                              </span>
                            </div>
                          </div>
                          <div class="ml-4">
                            <div class="text-sm font-medium text-base-content"><%= user.name %></div>
                          </div>
                        </div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-base-content"><%= user.email %></div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-base-content">
                          <%= if user.department, do: user.department.name, else: "No Department" %>
                        </div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-base-content">
                          <%= if user.role, do: user.role.name, else: "No Role" %>
                        </div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-base-content">
                          <%= if user.preferred_ai_api do %>
                            <span class="text-primary">
                              <%= user.preferred_ai_api.name %>
                            </span>
                            <div class="text-xs text-base-content/70">
                              <%= user.preferred_ai_api.provider %> - <%= user.preferred_ai_api.model_name %>
                            </div>
                          <% else %>
                            <span class="text-base-content/70">Default</span>
                          <% end %>
                        </div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <button 
                          phx-click="toggle_status" 
                          phx-value-id={user.id} 
                          phx-value-type="user"
                          class={[
                            "inline-flex px-2 py-1 text-xs font-semibold rounded-full cursor-pointer transition-colors",
                            if(user.is_active, do: "bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400 hover:bg-green-200 dark:hover:bg-green-900/30", else: "bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-400 hover:bg-red-200 dark:hover:bg-red-900/30")
                          ]}
                        >
                          <%= if user.is_active, do: "Active", else: "Inactive" %>
                        </button>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <.link
                          href={~p"/admin/users/#{user.id}/edit"}
                          class="text-primary hover:text-primary/80 mr-4"
                        >
                          Edit
                        </.link>
                        <button
                          phx-click="delete"
                          phx-value-id={user.id}
                          phx-value-type="user"
                          data-confirm="Are you sure you want to delete this user?"
                          class="text-error hover:text-error/80"
                        >
                          Delete
                        </button>
                      </td>
                    </tr>
                  </tbody>
                </table>
              <% else %>
                <%= if @current_page == "departments" do %>
                  <table class="min-w-full divide-y divide-base-300">
                    <thead class="bg-base-300">
                      <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Name</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Description</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Status</th>
                        <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
                      </tr>
                    </thead>
                    <tbody class="bg-base-100 divide-y divide-base-300">
                      <tr :for={department <- @departments} id={"department-#{department.id}"}>
                        <td class="px-6 py-4 whitespace-nowrap">
                          <div class="text-sm font-medium text-base-content"><%= department.name %></div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                          <div class="text-sm text-base-content"><%= department.description %></div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                          <button 
                            phx-click="toggle_status" 
                            phx-value-id={department.id} 
                            phx-value-type="department"
                            class={[
                              "inline-flex px-2 py-1 text-xs font-semibold rounded-full cursor-pointer transition-colors",
                              if(department.is_active, do: "bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400 hover:bg-green-200 dark:hover:bg-green-900/30", else: "bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-400 hover:bg-red-200 dark:hover:bg-red-900/30")
                            ]}
                          >
                            <%= if department.is_active, do: "Active", else: "Inactive" %>
                          </button>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                          <.link
                            href={~p"/admin/departments/#{department.id}/edit"}
                            class="text-primary hover:text-primary/80 mr-4"
                          >
                            Edit
                          </.link>
                          <button
                            phx-click="delete"
                            phx-value-id={department.id}
                            phx-value-type="department"
                            data-confirm="Are you sure you want to delete this department?"
                            class="text-error hover:text-error/80"
                          >
                            Delete
                          </button>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                <% else %>
                  <%= if @current_page == "roles" do %>
                    <table class="min-w-full divide-y divide-base-300">
                      <thead class="bg-base-300">
                        <tr>
                          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Name</th>
                          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Description</th>
                          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Status</th>
                          <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
                        </tr>
                      </thead>
                      <tbody class="bg-base-100 divide-y divide-base-300">
                        <tr :for={role <- @roles} id={"role-#{role.id}"}>
                          <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-base-content"><%= role.name %></div>
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm text-base-content"><%= role.description %></div>
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap">
                            <button 
                              phx-click="toggle_status" 
                              phx-value-id={role.id} 
                              phx-value-type="role"
                              class={[
                                "inline-flex px-2 py-1 text-xs font-semibold rounded-full cursor-pointer transition-colors",
                                if(role.is_active, do: "bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400 hover:bg-green-200 dark:hover:bg-green-900/30", else: "bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-400 hover:bg-red-200 dark:hover:bg-red-900/30")
                              ]}
                            >
                              <%= if role.is_active, do: "Active", else: "Inactive" %>
                            </button>
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <.link
                              href={~p"/admin/roles/#{role.id}/edit"}
                              class="text-primary hover:text-primary/80 mr-4"
                            >
                              Edit
                            </.link>
                            <button
                              phx-click="delete"
                              phx-value-id={role.id}
                              phx-value-type="role"
                              data-confirm="Are you sure you want to delete this role?"
                              class="text-error hover:text-error/80"
                            >
                              Delete
                            </button>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  <% else %>
                    <%= if @current_page == "prompts" do %>
                      <table class="min-w-full divide-y divide-base-300">
                        <thead class="bg-base-300">
                          <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Title</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Department</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Role</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Status</th>
                            <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
                          </tr>
                        </thead>
                        <tbody class="bg-base-100 divide-y divide-base-300">
                          <tr :for={prompt <- @prompts} id={"prompt-#{prompt.id}"}>
                            <td class="px-6 py-4 whitespace-nowrap">
                              <div class="text-sm font-medium text-base-content"><%= prompt.title %></div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                              <div class="text-sm text-base-content">
                                <%= if prompt.department, do: prompt.department.name, else: "All Departments" %>
                              </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                              <div class="text-sm text-base-content">
                                <%= if prompt.role, do: prompt.role.name, else: "All Roles" %>
                              </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                              <button 
                                phx-click="toggle_status" 
                                phx-value-id={prompt.id} 
                                phx-value-type="prompt"
                                class={[
                                  "inline-flex px-2 py-1 text-xs font-semibold rounded-full cursor-pointer transition-colors",
                                  if(prompt.is_active, do: "bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400 hover:bg-green-200 dark:hover:bg-green-900/30", else: "bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-400 hover:bg-red-200 dark:hover:bg-red-900/30")
                                ]}
                              >
                                <%= if prompt.is_active, do: "Active", else: "Inactive" %>
                              </button>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                              <.link
                                href={~p"/admin/prompts/#{prompt.id}/edit"}
                                class="text-primary hover:text-primary/80 mr-4"
                              >
                                Edit
                              </.link>
                              <button
                                phx-click="delete"
                                phx-value-id={prompt.id}
                                phx-value-type="prompt"
                                data-confirm="Are you sure you want to delete this prompt?"
                                class="text-error hover:text-error/80"
                              >
                                Delete
                              </button>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    <% else %>
                      <%= if @current_page == "knowledge-bases" do %>
                        <table class="min-w-full divide-y divide-base-300">
                          <thead class="bg-base-300">
                            <tr>
                              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Name</th>
                              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Type</th>
                              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Department</th>
                              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Role</th>
                              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Status</th>
                              <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
                            </tr>
                          </thead>
                          <tbody class="bg-base-100 divide-y divide-base-300">
                            <tr :for={kb <- @knowledge_bases} id={"knowledge_base-#{kb.id}"}>
                              <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-base-content"><%= kb.name %></div>
                              </td>
                              <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-base-content"><%= kb.file_type %></div>
                              </td>
                              <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-base-content">
                                  <%= if kb.department, do: kb.department.name, else: "All Departments" %>
                                </div>
                              </td>
                              <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-base-content">
                                  <%= if kb.role, do: kb.role.name, else: "All Roles" %>
                                </div>
                              </td>
                              <td class="px-6 py-4 whitespace-nowrap">
                                <button 
                                  phx-click="toggle_status" 
                                  phx-value-id={kb.id} 
                                  phx-value-type="knowledge_base"
                                  class={[
                                    "inline-flex px-2 py-1 text-xs font-semibold rounded-full cursor-pointer transition-colors",
                                    if(kb.is_active, do: "bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400 hover:bg-green-200 dark:hover:bg-green-900/30", else: "bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-400 hover:bg-red-200 dark:hover:bg-red-900/30")
                                  ]}
                                >
                                  <%= if kb.is_active, do: "Active", else: "Inactive" %>
                                </button>
                              </td>
                              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <.link
                                  href={~p"/admin/knowledge-bases/#{kb.id}/edit"}
                                  class="text-primary hover:text-primary/80 mr-4"
                                >
                                  Edit
                                </.link>
                                <button
                                  phx-click="delete"
                                  phx-value-id={kb.id}
                                  phx-value-type="knowledge_base"
                                  data-confirm="Are you sure you want to delete this knowledge base?"
                                  class="text-error hover:text-error/80"
                                >
                                  Delete
                                </button>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      <% else %>
                        <%= if @current_page == "ai-apis" do %>
                          <table class="min-w-full divide-y divide-base-300">
                            <thead class="bg-base-300">
                              <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Name</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Provider</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Model</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Status</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-base-content/70 uppercase tracking-wide">Default</th>
                                <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
                              </tr>
                            </thead>
                            <tbody class="bg-base-100 divide-y divide-base-300">
                              <tr :for={api <- @ai_apis} id={"ai_api-#{api.id}"}>
                                <td class="px-6 py-4 whitespace-nowrap">
                                  <div class="text-sm font-medium text-base-content"><%= api.name %></div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                  <div class="text-sm text-base-content"><%= api.provider %></div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                  <div class="text-sm text-base-content"><%= api.model_name %></div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                  <button 
                                    phx-click="toggle_status" 
                                    phx-value-id={api.id} 
                                    phx-value-type="ai_api"
                                    class={[
                                      "inline-flex px-2 py-1 text-xs font-semibold rounded-full cursor-pointer transition-colors",
                                      if(api.is_active, do: "bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400 hover:bg-green-200 dark:hover:bg-green-900/30", else: "bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-400 hover:bg-red-200 dark:hover:bg-red-900/30")
                                    ]}
                                  >
                                    <%= if api.is_active, do: "Active", else: "Inactive" %>
                                  </button>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                  <%= if api.is_default do %>
                                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900/20 dark:text-blue-400">
                                      Default
                                    </span>
                                  <% else %>
                                    <button 
                                      phx-click="set_default" 
                                      phx-value-id={api.id} 
                                      phx-value-type="ai_api"
                                      class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 cursor-pointer transition-colors"
                                      title="Set as default"
                                    >
                                      Set Default
                                    </button>
                                  <% end %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                  <.link
                                    href={~p"/admin/ai-apis/#{api.id}/edit"}
                                    class="text-primary hover:text-primary/80 mr-4"
                                  >
                                    Edit
                                  </.link>
                                  <button
                                    phx-click="delete"
                                    phx-value-id={api.id}
                                    phx-value-type="ai_api"
                                    data-confirm="Are you sure you want to delete this AI API?"
                                    class="text-error hover:text-error/80"
                                  >
                                    Delete
                                  </button>
                                </td>
                              </tr>
                            </tbody>
                          </table>
                        <% else %>
                          <div class="text-center py-8">
                            <p class="text-base-content/70">Table for <%= @current_page %> will be implemented here.</p>
                          </div>
                        <% end %>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
        </div>
      </div>
    </div>
  </div>
</div>


