<div class="min-h-screen bg-base-100">
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-base-200 border-b border-base-300 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <h1 class="text-xl font-bold text-base-content flex items-center">
              <svg class="w-6 h-6 mr-2 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              AI Chat
            </h1>
          </div>
        </div>
        
        <div class="flex items-center space-x-4">
          <!-- Theme Toggle -->
          <.theme_toggle />
          
          <div class="text-sm text-base-content">
            Welcome, <span class="font-medium"><%= @current_user.name %></span>
          </div>
          <.link
            href={~p"/logout"}
            method="delete"
            class="btn btn-error btn-sm"
          >
            Sign Out
          </.link>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8 pt-20">
    <div class="px-4 py-6 sm:px-0">
      
      <!-- Chat Interface -->
      <div :if={@current_conversation} class="flex h-[calc(100vh-12rem)]">
        <!-- Conversations Sidebar -->
        <div class="w-80 flex-shrink-0 mr-6">
          <div class="card bg-base-200 shadow-xl h-full">
            <div class="card-body flex flex-col">
              <div class="flex items-center justify-between mb-4">
                <h2 class="card-title text-base-content text-lg">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                  Conversations
                </h2>
                <button 
                  class="btn btn-primary btn-sm"
                  phx-click="quick_start"
                >
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                  New
                </button>
              </div>
              
              <div class="flex-1 space-y-2 overflow-y-auto">
                <div :for={conversation <- @conversations} class={"group p-3 rounded-lg cursor-pointer transition-all duration-200 #{if conversation.id == @current_conversation.id, do: "bg-primary/20 border border-primary/30", else: "hover:bg-base-300/50"}"}
                     phx-click="select_conversation" phx-value-id={conversation.id}>
                  <div class="flex items-center justify-between">
                    <div class="flex-1 min-w-0">
                      <p class={"text-sm font-medium truncate #{if conversation.id == @current_conversation.id, do: "text-primary", else: "text-base-content"}"}>
                        <%= conversation.title || "Untitled Conversation" %>
                      </p>
                      <p class="text-xs text-base-content/70">
                        <%= Calendar.strftime(conversation.updated_at, "%m/%d %H:%M") %>
                      </p>
                    </div>
                    <div class="flex items-center space-x-1 opacity-0 group-hover:opacity-100 transition-opacity">
                      <button 
                        class="btn btn-ghost btn-xs text-base-content/70 hover:text-base-content hover:bg-base-300/50"
                        phx-click="rename_conversation" 
                        phx-value-id={conversation.id}
                        phx-stop-propagation
                        title="Rename"
                      >
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                      </button>
                      <button 
                        class="btn btn-ghost btn-xs text-error hover:text-error hover:bg-error/10"
                        phx-click="delete_conversation" 
                        phx-value-id={conversation.id}
                        phx-confirm="Are you sure you want to delete this conversation?"
                        phx-stop-propagation
                        title="Delete"
                      >
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Chat Area -->
        <div class="flex-1 max-w-4xl">
          <div class="card bg-base-200 shadow-xl h-full flex flex-col">
            <!-- Chat Header -->
            <div class="px-6 py-3 border-b border-base-300">
              <div class="flex items-center justify-between">
                <h1 class="text-lg font-medium text-base-content">
                  <%= @current_conversation.title || "Untitled Conversation" %>
                </h1>
                <div :if={@current_ai_api} class="flex items-center space-x-2 text-sm text-base-content/70">
                  <div class="flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span class="font-medium"><%= @current_ai_api.name %></span>
                    <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded-full">
                      <%= @current_ai_api.model_name %>
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Messages Area -->
            <div class="flex-1 overflow-y-auto" id="messages-container">
              <div class="max-w-3xl mx-auto px-4 py-6">
                <div class="space-y-6">
                  <div :for={message <- @messages} class={"flex #{if message.role == "user", do: "justify-end", else: "justify-start"} #{if @is_streaming and message.role == "assistant" and message.id == @temp_ai_message_id, do: "hidden", else: ""}"}>
                    <div class={"max-w-[80%] px-4 py-3 rounded-2xl #{if message.role == "user", do: "bg-primary text-primary-content", else: "bg-base-100 text-base-content border border-base-300"}"}>
                      <!-- Think content for AI messages -->
                      <div :if={message.role == "assistant" and (not is_binary(message.id) or String.starts_with?(message.id, "temp_") == false) and (Map.get(message.metadata || %{}, "think_content", "") != "" or @final_think_content != "")} class="mb-2 pb-2 border-b border-base-300">
                        <div class="flex items-center justify-between mb-2">
                          <div class="flex items-center space-x-2">
                            <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                            </svg>
                            <span class="text-sm font-medium text-primary">Thinking Process</span>
                          </div>
                          <button 
                            phx-click="toggle_think_content" 
                            class="text-xs text-base-content/60 hover:text-base-content/80 transition-colors"
                          >
                            <span class="inline-block transform transition-transform duration-200" style={"transform: #{if @show_think_content, do: "rotate(0deg)", else: "rotate(-90deg)"}"}>▼</span>
                          </button>
                        </div>
                        <div :if={@show_think_content} class="text-xs text-base-content/70  font-mono leading-relaxed">
                          <%= cond do %>
                            <% @is_streaming -> %>
                              <%= @streaming_think_content %>
                            <% (not is_binary(message.id) or String.starts_with?(message.id, "temp_") == false) and Map.get(message.metadata || %{}, "think_content", "") != "" -> %>
                              <%= Map.get(message.metadata, "think_content") %>
                            <% true -> %>
                              <%= @final_think_content %>
                          <% end %>
                        </div>
                      </div>
                      
                      <p class="text-sm  leading-relaxed">
                        <%= message.content %>
                      </p>
                      <p class={"text-xs mt-2 #{if message.role == "user", do: "text-primary-content/70", else: "text-base-content/50"}"}>
                        <%= Calendar.strftime(message.inserted_at, "%I:%M %p") %>
                      </p>
                    </div>
                  </div>
                  
                  <!-- Loading indicator -->
                  <div :if={@is_loading} class="flex justify-start">
                    <div class="max-w-[80%] px-4 py-3 rounded-2xl bg-base-100 text-base-content border border-base-300">
                      <div class="flex items-center space-x-3">
                        <div class="loading loading-spinner loading-sm text-primary"></div>
                        <span class="text-sm text-base-content/70">AI is thinking...</span>
                      </div>
                    </div>
                  </div>
                  
                  <!-- Streaming AI message with think content -->
                  <div :if={@is_streaming and @streaming_content != ""} class="flex justify-start">
                    <div class="max-w-[80%] px-4 py-3 rounded-2xl bg-base-100 text-base-content border border-base-300">
                      <!-- Think content for streaming -->
                      <div :if={@streaming_think_content != "" or @final_think_content != ""} class="mb-2 pb-2 border-b border-base-300">
                        <div class="flex items-center justify-between mb-2">
                          <div class="flex items-center space-x-2">
                            <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                            </svg>
                            <span class="text-sm font-medium text-primary">Thinking Process</span>
                          </div>
                          <button 
                            phx-click="toggle_think_content" 
                            class="text-xs text-base-content/60 hover:text-base-content/80 transition-colors"
                          >
                            <span class="inline-block transform transition-transform duration-200" style={"transform: #{if @show_think_content, do: "rotate(0deg)", else: "rotate(-90deg)"}"}>▼</span>
                          </button>
                        </div>
                        <div :if={@show_think_content} class="text-xs text-base-content/70  font-mono leading-relaxed">
                          <%= if @streaming_think_content != "", do: @streaming_think_content, else: @final_think_content %>
                        </div>
                      </div>
                      
                      <p class="text-sm  leading-relaxed"><%= @streaming_content %></p>
                    </div>
                  </div>
                  
                  <!-- Streaming indicator -->
                  <div :if={@is_streaming and @streaming_content == ""} class="flex justify-start">
                    <div class="max-w-[80%] px-4 py-3 rounded-2xl bg-base-100 text-base-content border border-base-300">
                      <div class="flex items-center space-x-3">
                        <div class="flex space-x-1">
                          <div class="w-2 h-2 bg-primary rounded-full animate-bounce"></div>
                          <div class="w-2 h-2 bg-primary rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
                          <div class="w-2 h-2 bg-primary rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                        </div>
                        <span class="text-sm text-base-content/70">AI is responding...</span>
                      </div>
                    </div>
                  </div>
                  
                  <div :if={Enum.empty?(@messages) and not @is_loading} class="text-center text-base-content/70 py-16">
                    <svg class="mx-auto h-20 w-20 text-base-content/30 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    <p class="text-xl font-medium mb-3">Start a conversation</p>
                    <p class="text-base">Type a message below to begin chatting with AI</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Message Input -->
            <div class="border-t border-base-300 p-4">
              <div class="max-w-3xl mx-auto">
                <form phx-submit="send_message" class="flex items-end space-x-3">
                  <div class="flex-1">
                    <label for="message_content" class="sr-only">Message</label>
                    <textarea
                      name="message[content]"
                      id="message_content"
                      phx-keyup="update_message"
                      phx-value-value={@new_message}
                      phx-key="keydown"
                      phx-key-code="13"
                      phx-window-keydown="handle_enter"
                      rows="1"
                      class="textarea textarea-bordered w-full bg-base-100 text-base-content placeholder-base-content/50 resize-none focus:outline-none focus:ring-2 focus:ring-primary/20 min-h-[44px] max-h-32"
                      placeholder="Message AI..."
                      disabled={@is_loading}
                      required
                    ><%= @new_message %></textarea>
                  </div>
                  <div class="flex-shrink-0">
                    <button
                      type="submit"
                      class="btn btn-primary btn-square h-11 w-11"
                      disabled={@is_loading}
                    >
                      <span :if={@is_loading} class="loading loading-spinner loading-sm"></span>
                      <span :if={not @is_loading}>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                        </svg>
                      </span>
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Conversations List (when no conversation selected) -->
      <div :if={is_nil(@current_conversation)}>
        <div class="sm:flex sm:items-center">
          <div class="sm:flex-auto">
            <h1 class="text-2xl font-semibold text-base-content">My Conversations</h1>
            <p class="mt-2 text-sm text-base-content/80">
              Start a new conversation or continue an existing one.
            </p>
          </div>
          <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
            <button 
              class="btn btn-primary"
              phx-click="quick_start"
            >
              Quick Start Chat
            </button>
          </div>
        </div>
        
        <div class="mt-8">
          <div class="card bg-base-200 shadow-xl">
            <ul class="divide-y divide-base-300">
              <li :for={conversation <- @conversations} class="px-6 py-4">
                <div 
                  class="block hover:bg-base-300/50 p-4 cursor-pointer"
                  phx-click="select_conversation" 
                  phx-value-id={conversation.id}
                >
                  <div class="flex items-center justify-between">
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-medium text-primary truncate">
                        <%= conversation.title || "Untitled Conversation" %>
                      </p>
                      <p class="mt-1 text-sm text-base-content/70">
                        Created <%= Calendar.strftime(conversation.inserted_at, "%B %d, %Y at %I:%M %p") %>
                      </p>
                    </div>
                    <div class="ml-5 flex-shrink-0">
                      <svg class="h-5 w-5 text-base-content/50" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                      </svg>
                    </div>
                  </div>
                </div>
              </li>
              
              <li :if={Enum.empty?(@conversations)} class="px-6 py-12 text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No conversations</h3>
                <p class="mt-1 text-sm text-gray-500">Get started by creating a new conversation.</p>
                <div class="mt-6">
                  <button 
                    class="btn btn-primary"
                    phx-click="quick_start"
                  >
                    Quick Start Chat
                  </button>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Auto-scroll to bottom when new messages arrive
  function scrollToBottom() {
    const messagesContainer = document.getElementById('messages-container');
    if (messagesContainer) {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    scrollToBottom();
  });
  
  // Scroll to bottom after LiveView updates
  window.addEventListener('phx:update', function() {
    scrollToBottom();
  });

  // Handle Enter key for sending messages (only when not using IME)
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Enter' && !event.ctrlKey && !event.shiftKey) {
      const textarea = document.getElementById('message_content');
      if (document.activeElement === textarea) {
        // Check if IME is composing (for Chinese, Japanese, Korean input)
        if (event.isComposing || event.keyCode === 229) {
          return; // Don't submit when IME is composing
        }
        
        // Check if textarea is disabled (loading state)
        if (textarea.disabled) {
          return; // Don't submit when loading
        }
        
        event.preventDefault();
        // Trigger the form submission
        const form = textarea.closest('form');
        if (form) {
          form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
        }
      }
    }
  });

  // Auto-resize textarea
  function autoResizeTextarea() {
    const textarea = document.getElementById('message_content');
    if (textarea) {
      textarea.style.height = 'auto';
      textarea.style.height = Math.min(textarea.scrollHeight, 128) + 'px';
    }
  }

  // Set up auto-resize
  document.addEventListener('DOMContentLoaded', function() {
    const textarea = document.getElementById('message_content');
    if (textarea) {
      textarea.addEventListener('input', autoResizeTextarea);
    }
  });

  // Re-setup after LiveView updates
  window.addEventListener('phx:update', function() {
    const textarea = document.getElementById('message_content');
    if (textarea) {
      textarea.removeEventListener('input', autoResizeTextarea);
      textarea.addEventListener('input', autoResizeTextarea);
    }
  });
</script>
